APIPORT=7300
DEVPORT=7301
HOST=0.0.0.0

# Unified bronze database (PGlite data directory). This repo only reads it —
# the sibling NFLETL project owns schema creation and all writes. Make sure
# this resolves to the SAME directory as NFLETL's DB_PATH.
DB_PATH=./data/bronze.db

# Default row limit for GET /api/bronze/:source/:table when ?limit= is omitted (max 10000)
BRONZE_LIMIT_DEFAULT=1000
