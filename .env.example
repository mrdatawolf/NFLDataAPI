APIPORT=7300
DEVPORT=7301
HOST=0.0.0.0

# Unified bronze database (PGlite data directory)
DB_PATH=./data/bronze.db

# Automatic ingest
SCAN_INTERVAL_HOURS=1
SCAN_ON_START=true

# --- Sources ---
# Each source has a TYPE (sqlite | pglite) and a PATH.
# A source with an empty PATH is treated as "not configured" and skipped.
# For pglite sources point PATH at the PGlite data directory; for sqlite, at the .sqlite3 file.
# Always point at a clone/copy of the production database, never the live one.

RAPTOR_TYPE=sqlite
RAPTOR_PATH=

SAWFILERS_TYPE=sqlite
SAWFILERS_PATH=./Examples/SawFilers/app-db.sqlite3

# Porter is mocked until we get the real vendor database. Run `npm run seed:porter`
# to create and populate it, then it is ingested like any other source.
PORTER_TYPE=pglite
PORTER_PATH=./data/porter-mock
