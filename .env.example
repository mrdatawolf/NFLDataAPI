APIPORT=7300
DEVPORT=7301
HOST=0.0.0.0

# PostgreSQL 17 connection shared by the bronze and silver pools. Quote the
# password if it contains #, spaces, or shell metacharacters.
PGHOST=localhost
PGPORT=5432
PGUSER=nfldataapi
PGPASSWORD='replace-with-a-development-password'
BRONZE_PGDATABASE=bronze
SILVER_PGDATABASE=silver

# Default row limit for GET /api/bronze/:source/:table when ?limit= is omitted (max 10000)
BRONZE_LIMIT_DEFAULT=1000
